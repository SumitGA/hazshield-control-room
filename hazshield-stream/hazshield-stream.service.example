[Unit]
Description=HazShield stream service (control room backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hazstream
Group=hazstream
WorkingDirectory=/opt/hazshield-stream
ExecStart=/opt/hazshield-stream/venv/bin/python3 app.py
Restart=on-failure
RestartSec=3
StartLimitBurst=5
StartLimitIntervalSec=60
# HAZ_REDIS_URL / HAZ_DATABASE_URL via drop-in: systemctl edit hazshield-stream
Environment=HAZ_HTTP_PORT=8010
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=256M

[Install]
WantedBy=multi-user.target
